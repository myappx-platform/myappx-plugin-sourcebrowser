Manifest-Version: 1.0
Automatic-Module-Name: org.idempiere.myappx.plugin.sourcebrowser
Bundle-ManifestVersion: 2
Bundle-Name: MyAppx Plugin : Source Browser
Bundle-SymbolicName: org.idempiere.myappx.plugin.sourcebrowser;singleton:=true
Bundle-Version: 14.0.0.qualifier
Bundle-Activator: org.idempiere.myappx.plugin.sourcebrowser.Activator
Bundle-Vendor: Ken Longnan <ken.longnan@gmail.com>
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=17))"
Web-ContextPath: /sourcebrowser
Jetty-Environment: ee8
Eclipse-BundleShape: dir
Export-Package: org.idempiere.myappx.plugin.sourcebrowser.api
Require-Bundle: org.adempiere.base;bundle-version="0.0.0",
 org.adempiere.plugin.utils;bundle-version="0.0.0",
 org.adempiere.ui.zk;bundle-version="0.0.0",
 org.idempiere.myappx.plugin.odt;bundle-version="0.0.0",
 org.eclipse.osgi,
 com.google.gson;bundle-version="2.9.0",
 zcommon;bundle-version="10.0.1",
 zel;bundle-version="10.0.1",
 zhtml;bundle-version="10.0.1",
 zk;bundle-version="10.0.1",
 zkbind;bundle-version="10.0.1",
 zul;bundle-version="10.0.1"
Import-Package: javax.servlet;version="4.0.0",
 javax.servlet.http;version="4.0.0",
 org.adempiere.webui.apps,
 org.adempiere.webui.component,
 org.adempiere.webui.desktop,
 org.adempiere.webui.factory,
 org.adempiere.webui.panel,
 org.adempiere.webui.part,
 org.adempiere.webui.session,
 org.adempiere.webui.util,
 org.idempiere.ui.zk.annotation,
 org.osgi.framework,
 org.osgi.service.component.annotations,
 org.osgi.service.event;version="1.3.0"
Service-Component: OSGI-INF/*.xml
Bundle-ClassPath: .
Bundle-ActivationPolicy: lazy
